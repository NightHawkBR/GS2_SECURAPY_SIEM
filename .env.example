# Copie para .env e troque os valores — o .env nunca vai para o Git nem para a imagem.
# Gerar segredos: python -c "import secrets; print(secrets.token_urlsafe(32))"

API_TOKEN=troque-por-um-token-aleatorio-de-32-ou-mais-caracteres
SECRET_KEY=troque-por-outra-chave-aleatoria-de-32-ou-mais-caracteres

# JWT dos operadores (POST /api/token) — vazio usa a SECRET_KEY
JWT_SECRET=
JWT_EXPIRA_MINUTOS=30

MYSQL_ROOT_PASSWORD=troque-senha-root
MYSQL_DATABASE=securapy
MYSQL_USER=securapy
MYSQL_PASSWORD=troque-senha-app

# LLM — sem chave o assistente usa o fallback por regras (modo mock)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MODO=auto

# Opcional — sem token vale o limite gratuito do ipinfo.io
IPINFO_TOKEN=

# Portas no host, caso 27017/3306 já estejam ocupadas
MONGO_PORTA_HOST=27017
MYSQL_PORTA_HOST=3306
